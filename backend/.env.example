# Telegram Bot API token
BOT_TOKEN=

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=poker_club
DB_SSLMODE=disable

# Webhook configuration (used when LONG_POLLING=false)
WEBHOOK_URL=
WEBHOOK_PORT=8080

# Use long polling instead of webhook (for local development)
LONG_POLLING=true

# Log level: debug, info, warn, error
LOG_LEVEL=info
